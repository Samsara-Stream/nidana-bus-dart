digraph topologies {
  rankdir=LR;
  t0 [shape=ellipse, label="odd.<record>\nevent ({int a, String b})"];
  t1 [shape=ellipse, label="odd.back\\slash\nevent String"];
  t2 [shape=ellipse, label="odd.café\nline\nstate int?"];
  t3 [shape=ellipse, label="odd.table \"x\" #1\nstate List<Map<String, int>>"];
  subgraph cluster_p0 {
    label="idle\npage";
  }
  subgraph cluster_p1 {
    label="odd \"quoted\" #1 <tag> back\\slash café\nmodule";
    p1e0 [shape=box, label="map\nto$Label"];
    p1e1 [shape=box, label="filter\n(anonymous)"];
    p1e2 [shape=box, label="write"];
    p1e3 [shape=box, label="write"];
    p1e4 [shape=box, label="write"];
  }
  s0 [shape=box, style=rounded, label="page:checkout/cart?step=\"2\"\nmodule"];
  t3 -> p1e0;
  t0 -> p1e1;
  p1e0 -> p1e2;
  p1e2 -> t1;
  p1e1 -> p1e3;
  p1e3 -> t0;
  t2 -> p1e4 [label="dedup equality"];
  p1e4 -> t2;
  s0 -> t3;
}
